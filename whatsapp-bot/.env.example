# Copia este archivo a ".env" y ajusta lo que necesites. Todo es opcional.

# Chat (tu número en formato 5211234567@s.whatsapp.net, o el id de un grupo)
# al que el bot avisa de eventos del sistema, ej. "me reconecté tras estar caído".
# También es el único chat autorizado para crear/editar/borrar reuniones de
# padres por WhatsApp (!reunion agregar/editar/borrar/listar).
# Déjalo vacío para desactivar estos avisos y esos subcomandos.
OWNER_CHAT_ID=

# Cuántos backups diarios de auth_info/ y data/bot.db conservar (los más viejos se borran).
BACKUP_KEEP=7

# Minutos de desconexión seguidos a partir de los cuales el bot avisa al reconectar.
DOWNTIME_ALERT_MIN=5

# Panel de administrador (docentes, horarios por grado/sección, calendario cívico).
# Sin estos 3 valores configurados, el panel simplemente NO arranca (el bot de
# WhatsApp sigue funcionando normal). Pensado solo para red local — no expongas
# este puerto a Internet.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_PORT=4500
